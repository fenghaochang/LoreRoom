  "bin": { "loreroom": "dist/cli.js" },
  "files": ["dist", "config.example.json", "README.md"],
  "scripts": {
    "build": "tsc",
    "test": "vitest run",
    "mcp": "node dist/mcp-server.js",
    "init": "node dist/cli.js init"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.29.0",
    "better-sqlite3-multiple-ciphers": "^12.10.0",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
